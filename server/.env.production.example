# ==========================================================
# 后端生产环境配置模板 (复制为 server/.env.production 并填写)
# 生产环境: NODE_ENV=production 启动
# ==========================================================

NODE_ENV=production
PORT=8787
MAX_UPLOAD_MB=10

# ---- 安全 ----
# CORS 白名单: 允许访问后端的前端域名, 逗号分隔 (必填, 留空则拒绝所有跨域)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# API 鉴权 Token: 设置后所有 /api 请求需带 Authorization: Bearer <token>
# API_TOKEN=please-set-a-long-random-token
# 限流: 每 IP 每分钟最大请求数
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# ---- 模型 (与 .env 相同, 生产用独立密钥) ----
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-max
SOLVER_PROVIDER=auto
# LLM 单次调用超时(毫秒)
LLM_TIMEOUT_MS=180000

# ---- 可选增强 ----
# MATH_OCR_ENGINE=none
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
