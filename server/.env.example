# ==========================================================
# 智能判题后端环境配置  (复制本文件为 server/.env 后填写)
# ==========================================================

# ---- 服务配置 ----
PORT=8787
# 上传图片大小上限 (MB)
MAX_UPLOAD_MB=10

# ---- 视觉模型 (必需三选一: 负责三区切分 + 公式识别) ----
# 探测顺序: VISION_PROVIDER 显式指定 > 按已配置的密钥自动选择 (qwen > openai > gemini)
# VISION_PROVIDER=auto | qwen | openai | gemini
VISION_PROVIDER=auto

# ① 阿里云百炼 Qwen-VL (推荐: 中文印刷/手写数学 OCR 最强, 国内直连)
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-max

# ② OpenAI GPT-4o (备选)
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o

# ③ Google Gemini 2.5 Flash (备选, 免费额度大)
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.5-flash

# ---- 数学专用 OCR 增强 (可选: 对手写公式保真度最高) ----
# MATH_OCR_ENGINE=none | mathpix
MATH_OCR_ENGINE=none
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=

# ---- 解题/判题 LLM (可选) ----
# 默认 auto: 复用视觉模型厂商的文本模型(同一把密钥), 无需额外密钥。
# 若想用 DeepSeek 判题(数学能力强且便宜), 设 SOLVER_PROVIDER=deepseek 并填 DEEPSEEK_API_KEY。
# SOLVER_PROVIDER=auto | deepseek | qwen | openai | gemini
SOLVER_PROVIDER=auto
# DEEPSEEK_API_KEY=
# SOLVER_MODEL=deepseek-chat
